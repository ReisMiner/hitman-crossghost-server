# Patcher

Patcher/*.suo
Patcher/.vs/
Patcher/bin/
Patcher/obj/


# Server

Server/.vscode/
Server/node_modules/

# no user profile data
Server/userdata/*/users/**
# except IOI profile
!Server/userdata/*/users/fadb923c-e6bb-4283-a537-eb4d1150262e.json

# no external id => profile id bindings
Server/userdata/*/*ids/**
# but keep the folders
!Server/userdata/*/*ids/.gitkeep

# no contract data
Server/contractdata/**
# except for the supported ghost mode contracts
!Server/contractdata/c854d9c7-8991-42db-a2e4-3cf93e645e81.json
!Server/contractdata/d5ad70f4-7dbb-4b2b-b183-061778a51468.json
!Server/contractdata/8fcf8f5d-0fe9-47d7-bff3-d747d0cd1e89.json
!Server/contractdata/5e895adf-9879-44d9-b43f-13bb24e897bc.json
!Server/contractdata/59d1caab-2056-4f4b-a921-9958ef0a88eb.json

# no custom server data
Server/menudata/*/serverTile.json
Server/menudata/*/featuredContracts.json
Server/menudata/*/dynamic_resources_pc_release_rpkg.rpkg

.idea/

# Optional deployment overrides and backups
.env
.env.*
userdata-backup*.tar.gz
